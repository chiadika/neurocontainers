          }
        },
        {
          "id": "zyx_fx",
          "name": {
            "en": "zyx_fx"
          }
        },
        {
          "id": "zyx_fy",
          "name": {
            "en": "zyx_fy"
          }
        },
        {
          "id": "zyx_fxy",
          "name": {
            "en": "zyx_fxy"
          }
        },
        {
          "id": "zxy",
          "name": {
            "en": "zxy"
          }
        },
        {
          "id": "zxy_fx",
          "name": {
            "en": "zxy_fx"
          }
        },
        {
          "id": "zxy_fy",
          "name": {
            "en": "zxy_fy"
          }
        },
        {
          "id": "zxy_fxy",
          "name": {
            "en": "zxy_fxy"
          }
        },
        {
          "id": "debug",
          "name": {
            "en": "debug"
          }
        }
      ],
      "default": "zyx_fy",
      "information": {
        "en": "Mapping from trajectory components to acquisition axes. 'debug' emits every mapping as a separate series."
      }
    },
    {
      "id": "orientationflipslice",
      "label": {
        "en": "Flip slice order"
      },
      "type": "boolean",
      "default": false,
      "information": {
        "en": "Reverse the through-plane order before the display-frame canonicalisation."
      }
    }
  ]
}
