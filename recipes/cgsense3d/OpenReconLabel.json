          }
        },
        {
          "id": "2D",
          "name": {
            "en": "2D in-plane (like DistorCor2D)"
          }
        }
      ],
      "default": "3D",
      "information": {
        "en": "Gradient-nonlinearity correction applied in the recon (ICE's own functor cannot reach injected images). Needs the Siemens coeff_<coil>.grad in fire\\share (gradcoeffile 'auto', JSON only); skipped with a warning when it is missing."
      }
