        {
          "id": "debug",
          "name": {
            "en": "debug"
          }
        }
      ],
      "default": "xyz",
      "information": {
        "en": "Trajectory components placed on (slices, rows, columns); _fx/_fy reverse columns/rows. 'xyz' is right for the Terra.X Pulseq interpreter (x gradient runs F->H, z runs L->R). 'debug' emits every mapping as a separate series."
      }
    },
    {
      "id": "orientationflipslice",
      "label": {
        "en": "Flip slice order"
      },
      "type": "boolean",
      "default": false,
      "information": {
        "en": "Reverse the through-plane order before the display-frame canonicalisation."
      }
    },
    {
      "id": "gradunwarp",
      "label": {
        "en": "Distortion correction"
      },
      "type": "choice",
      "values": [
        {
          "id": "off",
          "name": {
