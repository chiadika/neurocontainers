{
  "general": {
    "name": {
      "en": "cgsense3d"
    },
    "version": "VERSION_WILL_BE_REPLACED_BY_SCRIPT",
    "vendor": "neurodesk",
    "information": {
      "en": "CG-SENSE (ESPIRiT maps, Toeplitz normal operator) for 3D radial and cones Pulseq acquisitions."
    },
    "id": "cgsense3d",
    "regulatory_information": {
      "device_trade_name": "cgsense3d",
      "production_identifier": "1.0",
      "manufacturer_address": "NeuroDesk",
      "made_in": "AU",
      "manufacture_date": "2026-01-01",
      "material_number": "cgsense3d_VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "gtin": "00000000000000",
      "udi": "(01)00000000000000(21)VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "safety_advices": "",
      "special_operating_instructions": "OpenRecon CG-SENSE reconstruction from raw k-space to magnitude image data",
      "additional_relevant_information": ""
    }
  },
  "reconstruction": {
    "transfer_protocol": {
      "protocol": "ISMRMRD",
      "version": "1.4.1"
    },
    "port": 9002,
    "emitter": "raw",
    "injector": "compleximage",
    "can_process_adjustment_data": true,
    "can_use_gpu": false,
    "min_required_memory": 32000,
    "min_count_required_cpu_cores": 10,
    "content_qualification_type": "RESEARCH"
  },
  "parameters": [
    {
      "id": "config",
      "label": {
        "en": "config"
      },
      "type": "choice",
      "values": [
        {
          "id": "cgsense3d",
          "name": {
            "en": "cgsense3d"
          }
        }
      ],
      "default": "cgsense3d",
      "information": {
        "en": "Module the MRD server loads. Must match the app module filename."
      }
    },
    {
      "id": "trajectoryfile",
      "label": {
        "en": "Bundled trajectory"
      },
      "type": "choice",
      "values": [
        {
          "id": "auto",
          "name": {
            "en": "Auto (match the acquired data)"
          }
        },
        {
          "id": "/opt/cgsense3d/radial3d_res128_us2x_trajectory.h5",
          "name": {
            "en": "radial 128^3, 2x undersampled (25536 spokes)"
          }
        },
        {
          "id": "/opt/cgsense3d/radial3d_res128_nyquist_trajectory.h5",
          "name": {
            "en": "radial 128^3, Nyquist (51071 spokes)"
          }
        },
        {
          "id": "/opt/cgsense3d/radial3d_n6434_trajectory.h5",
          "name": {
            "en": "radial 32^3, original (6434 spokes)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n4846_trajectory.h5",
          "name": {
            "en": "cones R=2 (4846 readouts, matrix 134)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n9598_trajectory.h5",
          "name": {
            "en": "cones fully sampled (9598 readouts, matrix 134)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n68785_trajectory.h5",
          "name": {
            "en": "cones 256^3 250 mm TE50 R=1 (68785 readouts, matrix 266, FOV 25.0)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n34506_trajectory.h5",
          "name": {
            "en": "cones 256^3 250 mm TE50 R=2 (34506 readouts, matrix 278, FOV 25.0)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n206435_trajectory.h5",
          "name": {
            "en": "cones 512^3 250 mm TR2 R=4 (206435 readouts, matrix 512, FOV 25.0)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n412489_trajectory.h5",
          "name": {
            "en": "cones 512^3 250 mm TR2 R=2 (412489 readouts, matrix 512, FOV 25.0)"
          }
        },
        {
          "id": "/opt/cgsense3d/cones3d_n34506_ir32_trajectory.h5",
          "name": {
            "en": "cones 256^3 IR-prepared, random order (34506 readouts, matrix 278, FOV 25.0) - select by name, not auto"
          }
        }
      ],
      "default": "auto",
      "information": {
        "en": "Auto matches the acquired (samples, readouts) against the bundled trajectories and any *_trajectory.h5 in fire\\share, on the whole stream when echosplit is set, and refuses a mismatch: phyllotaxis directions depend on the spoke count, so a wrong trajectory gives a wrong image, not a degraded one. Cones trajectories carry a precomputed DCF; matrixsize must equal the label extent named here."
      }
    },
    {
      "id": "matrixsize",
      "label": {
        "en": "Matrix size"
      },
      "type": "int",
      "minimum": 16,
      "maximum": 1024,
      "default": 128,
      "information": {
        "en": "Isotropic output matrix. 128 for the radial sequences (the 32^3 trajectory resolves about 32; larger values interpolate), 134 for the 220 mm cones, 266/278 for the 256^3 cones, 512 for the 512^3 cones. Must equal the sequence's LIN/PAR label extent."
      }
    },
    {
      "id": "fovcm",
      "label": {
        "en": "FOV cm"
      },
      "type": "string",
      "default": "22.0",
      "information": {
        "en": "Reconstruction field of view in cm. Must match the sequence FOV: 22.0 for the 128^3 sequences, 25.0 for the fov250 cones."
      }
    },
    {
      "id": "dcfmode",
      "label": {
        "en": "Density compensation"
      },
      "type": "choice",
      "values": [
        {
          "id": "auto",
          "name": {
            "en": "Auto (file, else analytic, else Pipe-Menon)"
          }
        },
        {
          "id": "file",
          "name": {
            "en": "From trajectory file"
          }
        },
        {
          "id": "analytic",
          "name": {
            "en": "Analytic |k|^2 (uniform radial only)"
          }
        },
        {
          "id": "pipe",
          "name": {
            "en": "Pipe-Menon (slow, any trajectory)"
          }
        }
      ],
      "default": "auto",
      "information": {
        "en": "Weights W of the data term and the starting (gridding) image. Auto uses the trajectory file's 'dcf' dataset when present (cut to the rows an echo or a short acquisition uses), analytic |k|^2 for uniformly-sampled radial, Pipe-Menon otherwise (minutes)."
      }
    },
    {
      "id": "cgiterations",
      "label": {
        "en": "CG iterations"
      },
      "type": "int",
      "minimum": 1,
      "maximum": 60,
      "default": 12,
      "information": {
        "en": "Conjugate gradient iterations. Doubles as the regulariser: stop early rather than converge."
      }
    },
    {
      "id": "cglamda",
      "label": {
        "en": "CG regularisation"
      },
      "type": "string",
      "default": "1e-3",
      "information": {
        "en": "Tikhonov weight in min ||W^1/2(Ax-y)||^2 + lamda||x||^2."
      }
    },
    {
      "id": "espiritmatrix",
      "label": {
        "en": "ESPIRiT matrix"
      },
      "type": "int",
      "minimum": 16,
      "maximum": 128,
      "default": 32,
      "information": {
        "en": "Grid size for ESPIRiT calibration. Maps are interpolated up to the output matrix. espiritthresh (0.02) and espiritcrop (0.8) are set from the JSON config only."
      }
    },
    {
      "id": "maxcoils",
      "label": {
        "en": "Max coils"
      },
      "type": "int",
      "minimum": 0,
      "maximum": 64,
      "default": 0,
      "information": {
        "en": "0 uses every receive channel (then PCA coil compression to 95% variance). A positive value keeps only the first N physical channels."
      }
    },
    {
      "id": "maxworkers",
      "label": {
        "en": "Worker threads"
      },
      "type": "int",
      "minimum": 1,
      "maximum": 32,
      "default": 8,
      "information": {
        "en": "Threads for the per-coil Toeplitz convolutions in every CG iteration. Capped by the number of virtual coils; the result does not depend on it."
      }
    },
    {
      "id": "echosplit",
      "label": {
        "en": "Echoes per TR"
      },
      "type": "int",
      "minimum": 1,
      "maximum": 4,
      "default": 1,
      "information": {
        "en": "1 for single-echo data. 2 for the two-echo cones files: acquisitions are split by their position in the TR (or by the contrast counter) and each echo is reconstructed into its own series (_echo1, _echo2). Acquisitions per trajectory row (1 for alternating echoes, 2 for rewind-and-repeat) are inferred from the counts."
      }
    },
